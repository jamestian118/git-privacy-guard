#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[secrets-check] gitleaks not found. Install it first: brew install gitleaks" >&2
  exit 1
fi

gitleaks git -v --log-opts=--all "$repo_root"
echo "[secrets-check] OK"
